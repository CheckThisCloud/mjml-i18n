{
  "name": "@checkthiscloud/mjml-i18n",
  "version": "0.0.2",
  "description": "i18n and variable interpolation for MJML v5 email templates — a single preprocessor with co-located, vue-i18n-style translations. Experimental (pre-1.0); API may change.",
  "author": "EntryLog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheckThisCloud/mjml-i18n.git"
  },
  "homepage": "https://github.com/CheckThisCloud/mjml-i18n#readme",
  "bugs": {
    "url": "https://github.com/CheckThisCloud/mjml-i18n/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "verify:build": "tsup && node scripts/smoke.mjs && node scripts/smoke.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mjml",
    "mjml-v5",
    "i18n",
    "internationalization",
    "translation",
    "email",
    "email-templates",
    "preprocessor",
    "interpolation"
  ],
  "dependencies": {
    "@jsep-plugin/object": "^1.2.2",
    "fast-xml-parser": "^5.8.0",
    "jsep": "^1.4.0"
  },
  "peerDependencies": {
    "mjml": "^5.2.2",
    "mjml-core": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "fast-check": "^4.8.0",
    "mjml": "^5.2.2",
    "mjml-core": "^5.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
